{
  "set_version": "guard-1.0",
  "_說明": "建議 8 的回歸集。與主測試集（v2.x／v3.0）完全獨立，不進入任何評分切片。",
  "_為什麼獨立": [
    "主測試集量的是「讀得多準」，這裡量的是「該擋的有沒有擋下來」——兩種不同的問題。",
    "混進主測試集會讓成分層的分母多出永遠拿不到分的案例，把頭條數字往下拉。",
    "教授明確要求三種檢查不可混成單一精確率：",
    "  『Verify rejection, explanation, and prevention of database insertions",
    "    without conflating them into a single misleading accuracy metric.』",
    "所以本集的回報方式是「9/9 通過」或失敗清單，不報百分比。"
  ],
  "_三個布林檢查": {
    "rejection": "_is_valid_food_scan() 回傳 False",
    "explanation": "回傳的原因非空，且不是無意義的預設字串",
    "no_db_write": "整個請求過程中沒有對資料庫執行任何 INSERT／UPDATE"
  },
  "_第三項為什麼最重要": "當初加這個閘門的唯一理由就是防資料污染（避免無關照片被分析後寫入資料庫），而那個唯一的理由從來沒被驗證過。",
  "cases": [
    {
      "case_id": "g01_食品無標示",
      "kind": "food_no_label",
      "desc": "散裝／裸賣食品，包裝上沒有成分與營養標示",
      "images": [],
      "expect": {"rejection": true, "explanation": true, "no_db_write": true}
    },
    {
      "case_id": "g02_食品無標示",
      "kind": "food_no_label",
      "desc": "同上，另一件商品",
      "images": [],
      "expect": {"rejection": true, "explanation": true, "no_db_write": true}
    },
    {
      "case_id": "g03_食品無標示",
      "kind": "food_no_label",
      "desc": "同上，另一件商品",
      "images": [],
      "expect": {"rejection": true, "explanation": true, "no_db_write": true}
    },
    {
      "case_id": "g04_非食品有標示版面",
      "kind": "nonfood_with_label",
      "desc": "化妝品全成分表——版面與食品成分標示高度相似，是最容易誤判的一類",
      "images": [],
      "expect": {"rejection": true, "explanation": true, "no_db_write": true}
    },
    {
      "case_id": "g05_非食品有標示版面",
      "kind": "nonfood_with_label",
      "desc": "清潔劑成分標示",
      "images": [],
      "expect": {"rejection": true, "explanation": true, "no_db_write": true}
    },
    {
      "case_id": "g06_非食品有標示版面",
      "kind": "nonfood_with_label",
      "desc": "藥品或保健品外盒的成分欄",
      "images": [],
      "expect": {"rejection": true, "explanation": true, "no_db_write": true}
    },
    {
      "case_id": "g07_完全無關",
      "kind": "unrelated",
      "desc": "與食品完全無關的照片（風景、人物、文件）",
      "images": [],
      "expect": {"rejection": true, "explanation": true, "no_db_write": true}
    },
    {
      "case_id": "g08_完全無關",
      "kind": "unrelated",
      "desc": "同上",
      "images": [],
      "expect": {"rejection": true, "explanation": true, "no_db_write": true}
    },
    {
      "case_id": "g09_完全無關",
      "kind": "unrelated",
      "desc": "同上",
      "images": [],
      "expect": {"rejection": true, "explanation": true, "no_db_write": true}
    }
  ]
}
