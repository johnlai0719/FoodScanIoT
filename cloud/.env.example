# 複製此檔為 .env 並填入你自己的本機/測試設定,.env 不會進版控。

# --- PostgreSQL 連線 ---
# 可用下方拆開的變數(預設),或改用 DATABASE_URL 整串連線字串覆蓋。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=product_db
DB_USER=postgres
DB_PASSWORD=your_local_password
# DATABASE_URL=postgresql+psycopg2://user:password@host:port/dbname

# --- AI / 外部服務金鑰(請自行申請,不要使用他人金鑰) ---
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- 其他 ---
JWT_SECRET=change_me_to_a_random_string
FOG_URL=http://localhost:3001
CLOUD_PORT=8000
TAILSCALE_IP=

# /api/analyze 的共享密鑰。Fog 以 X-API-Key 標頭帶上，兩邊必須一致。
# ⚠ 未設定時該端點**不受保護**——在 Tailscale（私有網路）下可接受，
#    在 Cloudflare Tunnel（公開 HTTPS）下必須設定，因為它會呼叫計費的 Gemini API。
#    `/health` 的 analyze_auth 欄位會回報目前狀態。
# ⚠ 不要把它嵌進手機 App：正式路徑是 App → Fog → Cloud，只有 Fog 需要持有。
# 產生方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
API_SHARED_SECRET=
