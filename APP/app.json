{
  "expo": {
    "name": "包裝喵懂 PackMeow",
    "slug": "packmeow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/packmeow-icon.png",
    "scheme": "expoapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "包裝喵懂 PackMeow需要在區域網路中尋找場域的 Fog 節點，以便在本地分析食品標示。"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/packmeow-icon.png"
    },
    "plugins": [
      "expo-image-picker",
      "expo-camera",
      "expo-status-bar"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
