
# Competition Docker: local paths only; never commit the actual .env or credentials.
COMPETITION_POSTGRES_DATA=./postgres_data
COMPETITION_UPLOADS_DATA=./server/uploads
COMPETITION_VISION_CREDENTIALS=C:/path/to/google-vision-service-account.json
# Set to this computer's Tailscale IPv4 for access from Pi; localhost is the default.
COMPETITION_CLOUD_BIND=127.0.0.1
