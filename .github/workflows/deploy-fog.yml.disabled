# 暫時停用(2026-07-24):樹莓派裝置已搬遷,PI_TAILSCALE_IP 需要更新後
# 才能恢復連線,否則此 workflow 會在 SSH 連線步驟失敗。
# 恢復方式:改回副檔名 .yml 即可重新啟用(內容未變動)。
name: Deploy Fog to Pi 5

on:
  push:
    branches: [main]
    paths:
      - 'fog/**'
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Connect to Tailscale
        uses: tailscale/github-action@v2
        with:
          authkey: ${{ secrets.TAILSCALE_AUTHKEY }}

      - name: Wait for Tailscale
        run: sleep 10

      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.PI_TAILSCALE_IP }}
          username: johnlai
          key: ${{ secrets.FOG_SSH_PRIVATE_KEY }}
          script: |
            cd /home/johnlai/fog/FoodScanIoT
            git pull origin main
            cd fog
            source venv/bin/activate
            pip install -r requirements.txt
            npm install --production
            npm run build
            sudo systemctl restart fog-python fog-node
            sleep 5
            curl -sf http://localhost:3001/health || exit 1
            curl -sf http://localhost:3002/health || exit 1
            echo "Deploy success"
