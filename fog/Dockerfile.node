# 使用輕量級的 Node.js 18 映像檔
FROM node:18-slim

# 設定工作目錄
WORKDIR /app

# 先複製 package.json 和 lock 檔以加速建置
COPY package*.json ./

# 安裝依賴項 (包含 better-sqlite3 需要編譯工具)
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && npm install \
    && apt-get purge -y --auto-remove python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# 複製其餘代碼
COPY . .

# 如果有 TypeScript，先編譯 (根據您的 package.json 有 build 指令)
RUN npm run build || true

# 暴露 3001 埠口 (與您的 APP 連線 IP 一致)
EXPOSE 3001

# 啟動服務 (預設執行 server.ts 或編譯後的 server.js)
# 由於您在開發階段，我會使用 ts-node 執行 server.ts，或者您可以改用 npm start
CMD ["npx", "ts-node", "server.ts"]
