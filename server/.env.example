# 複製此檔為 .env 並填入你自己的本機/測試設定,.env 不會進版控。

# --- PostgreSQL 連線 ---
# 可用下方拆開的變數(預設),或改用 DATABASE_URL 整串連線字串覆蓋。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=product_db
DB_USER=postgres
DB_PASSWORD=your_local_password
# DATABASE_URL=postgresql+psycopg2://user:password@host:port/dbname

# --- AI / 外部服務金鑰(請自行申請,不要使用他人金鑰) ---
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- 其他 ---
JWT_SECRET=change_me_to_a_random_string
FOG_URL=http://localhost:3001
CLOUD_PORT=8000
TAILSCALE_IP=
